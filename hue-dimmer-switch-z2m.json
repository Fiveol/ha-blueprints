blueprint:
  name: Philips Hue Dimmer Z2M - Full Automation with Multi-Press Interval
  domain: automation
  description: Full-featured Philips Hue Dimmer Z2M automation with click, hold, click+hold, hold+click, multi-button combos, and configurable multi-press interval
  input:
    action_sensor:
      name: Action Sensor
      selector:
        entity:
          integration: mqtt
          domain: sensor
    helper_last_controller_event:
      name: Helper - Last Controller Event
      selector:
        entity:
          domain: input_text
    multi_press_interval:
      name: Multi-Press Interval (ms)
      default: 100
      selector:
        number:
          min: 10
          max: 1000
          unit_of_measurement: ms
    power_1_click: { action: {} }
    power_2_click: { action: {} }
    power_3_click: { action: {} }
    power_4_click: { action: {} }
    power_5_click: { action: {} }
    power_6_click: { action: {} }
    power_7_click: { action: {} }
    power_8_click: { action: {} }
    power_9_click: { action: {} }
    power_10_click: { action: {} }
    power_1s_hold: { action: {} }
    power_3s_hold: { action: {} }
    power_5s_hold: { action: {} }
    power_10s_hold: { action: {} }
    power_1click_1s_hold: { action: {} }
    power_1click_3s_hold: { action: {} }
    power_1click_5s_hold: { action: {} }
    power_1click_10s_hold: { action: {} }
    power_1s_hold_1click: { action: {} }
    power_3s_hold_1click: { action: {} }
    power_5s_hold_1click: { action: {} }
    power_10s_hold_1click: { action: {} }
    up_1_click: { action: {} }
    up_2_click: { action: {} }
    up_3_click: { action: {} }
    up_4_click: { action: {} }
    up_5_click: { action: {} }
    up_6_click: { action: {} }
    up_7_click: { action: {} }
    up_8_click: { action: {} }
    up_9_click: { action: {} }
    up_10_click: { action: {} }
    up_1s_hold: { action: {} }
    up_3s_hold: { action: {} }
    up_5s_hold: { action: {} }
    up_10s_hold: { action: {} }
    up_1click_1s_hold: { action: {} }
    up_1click_3s_hold: { action: {} }
    up_1click_5s_hold: { action: {} }
    up_1click_10s_hold: { action: {} }
    up_1s_hold_1click: { action: {} }
    up_3s_hold_1click: { action: {} }
    up_5s_hold_1click: { action: {} }
    up_10s_hold_1click: { action: {} }
    down_1_click: { action: {} }
    down_2_click: { action: {} }
    down_3_click: { action: {} }
    down_4_click: { action: {} }
    down_5_click: { action: {} }
    down_6_click: { action: {} }
    down_7_click: { action: {} }
    down_8_click: { action: {} }
    down_9_click: { action: {} }
    down_10_click: { action: {} }
    down_1s_hold: { action: {} }
    down_3s_hold: { action: {} }
    down_5s_hold: { action: {} }
    down_10s_hold: { action: {} }
    down_1click_1s_hold: { action: {} }
    down_1click_3s_hold: { action: {} }
    down_1click_5s_hold: { action: {} }
    down_1click_10s_hold: { action: {} }
    down_1s_hold_1click: { action: {} }
    down_3s_hold_1click: { action: {} }
    down_5s_hold_1click: { action: {} }
    down_10s_hold_1click: { action: {} }
    hue_1_click: { action: {} }
    hue_2_click: { action: {} }
    hue_3_click: { action: {} }
    hue_4_click: { action: {} }
    hue_5_click: { action: {} }
    hue_6_click: { action: {} }
    hue_7_click: { action: {} }
    hue_8_click: { action: {} }
    hue_9_click: { action: {} }
    hue_10_click: { action: {} }
    hue_1s_hold: { action: {} }
    hue_3s_hold: { action: {} }
    hue_5s_hold: { action: {} }
    hue_10s_hold: { action: {} }
    hue_1click_1s_hold: { action: {} }
    hue_1click_3s_hold: { action: {} }
    hue_1click_5s_hold: { action: {} }
    hue_1click_10s_hold: { action: {} }
    hue_1s_hold_1click: { action: {} }
    hue_3s_hold_1click: { action: {} }
    hue_5s_hold_1click: { action: {} }
    hue_10s_hold_1click: { action: {} }
    power_up: { action: {} }
    power_down: { action: {} }
    power_hue: { action: {} }
    hue_up: { action: {} }
    hue_down: { action: {} }
    power_hue_up: { action: {} }
    power_hue_down: { action: {} }
    power_hue_up_down: { action: {} }
    multi_press_interval:
      name: Multi Press Interval (ms)
      default: 100
      selector:
        number:
          min: 10
          max: 2000
          step: 10
trigger:
  - platform: event
    event_type: state_changed
    event_data:
      entity_id: !input action_sensor

condition:
  - condition: template
    value_template: '{{ trigger.event.data.new_state.state not in ("", "None", "unknown") }}'
  - choose:
      - conditions: "{{ button_key != 'unknown' }}"
        sequence:
          - variables:
              last_click_down: "{{ json_state['down']['last_time'] if 'down' in json_state else 0 }}"
              click_count_down: >
                {% set elapsed = (now_ts - last_click_down) * 1000 %}
                {% if elapsed <= multi_press_interval %}{{ (json_state['down']['clicks'] | default(0)) + 1 }}
                {% else %}1{% endif %}
              updated_state_down: >
                {% set s = json_state.copy() %}
                {% set _ = s.update({'down': {'last_time': now_ts, 'clicks': click_count_down}}) %}
                {{ s }}
          - service: input_text.set_value
            data:
              entity_id: !input helper_last_controller_event
              value: "{{ updated_state_down | to_json }}"
          - variables:
              last_click_off: "{{ json_state['off']['last_time'] if 'off' in json_state else 0 }}"
              click_count_off: >
                {% set elapsed = (now_ts - last_click_off) * 1000 %}
                {% if elapsed <= multi_press_interval %}{{ (json_state['off']['clicks'] | default(0)) + 1 }}
                {% else %}1{% endif %}
              updated_state_off: >
                {% set s = json_state.copy() %}
                {% set _ = s.update({'off': {'last_time': now_ts, 'clicks': click_count_off}}) %}
                {{ s }}
          - service: input_text.set_value
            data:
              entity_id: !input helper_last_controller_event
              value: "{{ updated_state_off | to_json }}"
  - choose:
      - conditions: "{{ 'on' in json_state }}"
        sequence:
          - variables:
              clicks: "{{ json_state['on']['clicks'] | default(1) }}"
          - choose:
              - conditions: "{{ clicks == 1 }}"
                sequence: !input on_press
              - conditions: "{{ clicks == 2 }}"
                sequence: !input on_press_double
              - conditions: "{{ clicks == 3 }}"
                sequence: !input on_press_triple
              - conditions: "{{ clicks == 4 }}"
                sequence: !input on_press_quad
              - conditions: "{{ clicks == 5 }}"
                sequence: !input on_press_quint
              - conditions: "{{ clicks == 6 }}"
                sequence: !input on_press_sext
              - conditions: "{{ clicks == 7 }}"
                sequence: !input on_press_sept
              - conditions: "{{ clicks == 8 }}"
                sequence: !input on_press_oct
              - conditions: "{{ clicks == 9 }}"
                sequence: !input on_press_non
              - conditions: "{{ clicks == 10 }}"
                sequence: !input on_press_dec
      - conditions: "{{ 'up' in json_state }}"
        sequence:
          - variables:
              clicks: "{{ json_state['up']['clicks'] | default(1) }}"
          - choose:
              - conditions: "{{ clicks == 1 }}"
                sequence: !input up_press
              - conditions: "{{ clicks == 2 }}"
                sequence: !input up_press_double
              - conditions: "{{ clicks == 3 }}"
                sequence: !input up_press_triple
              - conditions: "{{ clicks == 4 }}"
                sequence: !input up_press_quad
              - conditions: "{{ clicks == 5 }}"
                sequence: !input up_press_quint
              - conditions: "{{ clicks == 6 }}"
                sequence: !input up_press_sext
              - conditions: "{{ clicks == 7 }}"
                sequence: !input up_press_sept
              - conditions: "{{ clicks == 8 }}"
                sequence: !input up_press_oct
              - conditions: "{{ clicks == 9 }}"
                sequence: !input up_press_non
              - conditions: "{{ clicks == 10 }}"
                sequence: !input up_press_dec
      - conditions: "{{ 'down' in json_state }}"
        sequence:
          - variables:
              clicks: "{{ json_state['down']['clicks'] | default(1) }}"
          - choose:
              - conditions: "{{ clicks == 1 }}"
                sequence: !input down_press
              - conditions: "{{ clicks == 2 }}"
                sequence: !input down_press_double
              - conditions: "{{ clicks == 3 }}"
                sequence: !input down_press_triple
              - conditions: "{{ clicks == 4 }}"
                sequence: !input down_press_quad
              - conditions: "{{ clicks == 5 }}"
                sequence: !input down_press_quint
              - conditions: "{{ clicks == 6 }}"
                sequence: !input down_press_sext
              - conditions: "{{ clicks == 7 }}"
                sequence: !input down_press_sept
              - conditions: "{{ clicks == 8 }}"
                sequence: !input down_press_oct
              - conditions: "{{ clicks == 9 }}"
                sequence: !input down_press_non
              - conditions: "{{ clicks == 10 }}"
                sequence: !input down_press_dec
      - conditions: "{{ 'off' in json_state }}"
        sequence:
          - variables:
              clicks: "{{ json_state['off']['clicks'] | default(1) }}"
          - choose:
              - conditions: "{{ clicks == 1 }}"
                sequence: !input off_press
              - conditions: "{{ clicks == 2 }}"
                sequence: !input off_press_double
              - conditions: "{{ clicks == 3 }}"
                sequence: !input off_press_triple
              - conditions: "{{ clicks == 4 }}"
                sequence: !input off_press_quad
              - conditions: "{{ clicks == 5 }}"
                sequence: !input off_press_quint
              - conditions: "{{ clicks == 6 }}"
                sequence: !input off_press_sext
              - conditions: "{{ clicks == 7 }}"
                sequence: !input off_press_sept
              - conditions: "{{ clicks == 8 }}"
                sequence: !input off_press_oct
              - conditions: "{{ clicks == 9 }}"
                sequence: !input off_press_non
              - conditions: "{{ clicks == 10 }}"
                sequence: !input off_press_dec
  - choose:
      - conditions: "{{ command.endswith('_hold') }}"
        sequence:
          - variables:
              hold_time: "{{ command.split('_hold')[0] | int(default=1) }}"
          - choose:
              - conditions: "{{ hold_time == 1 }}"
                sequence: !input hold_1s
              - conditions: "{{ hold_time == 3 }}"
                sequence: !input hold_3s
              - conditions: "{{ hold_time == 5 }}"
                sequence: !input hold_5s
              - conditions: "{{ hold_time == 10 }}"
                sequence: !input hold_10s
  - choose:
      - conditions: "{{ '_click_' in command and '_hold' in command }}"
        sequence:
          - variables:
              parts: "{{ command.split('_click_') }}"
              click_count: "{{ parts[0] | int }}"
              hold_time: "{{ parts[1].split('_hold')[0] | int }}"
          - choose:
              - conditions: "{{ click_count == 1 and hold_time == 1 }}"
                sequence: !input click1_hold1s
              - conditions: "{{ click_count == 1 and hold_time == 3 }}"
                sequence: !input click1_hold3s
              - conditions: "{{ click_count == 1 and hold_time == 5 }}"
                sequence: !input click1_hold5s
              - conditions: "{{ click_count == 1 and hold_time == 10 }}"
                sequence: !input click1_hold10s
              - conditions: "{{ click_count == 2 and hold_time == 1 }}"
                sequence: !input click2_hold1s
              - conditions: "{{ click_count == 2 and hold_time == 3 }}"
                sequence: !input click2_hold3s
              - conditions: "{{ click_count == 2 and hold_time == 5 }}"
                sequence: !input click2_hold5s
              - conditions: "{{ click_count == 2 and hold_time == 10 }}"
                sequence: !input click2_hold10s
  - choose:
      - conditions: "{{ '_hold_' in command and '_click' in command }}"
        sequence:
          - variables:
              parts: "{{ command.split('_hold_') }}"
              hold_time: "{{ parts[0] | int }}"
              click_count: "{{ parts[1].split('_click')[0] | int }}"
          - choose:
              - conditions: "{{ hold_time == 1 and click_count == 1 }}"
                sequence: !input hold1s_click1
              - conditions: "{{ hold_time == 1 and click_count == 2 }}"
                sequence: !input hold1s_click2
              - conditions: "{{ hold_time == 3 and click_count == 1 }}"
                sequence: !input hold3s_click1
              - conditions: "{{ hold_time == 3 and click_count == 2 }}"
                sequence: !input hold3s_click2
              - conditions: "{{ hold_time == 5 and click_count == 1 }}"
                sequence: !input hold5s_click1
              - conditions: "{{ hold_time == 5 and click_count == 2 }}"
                sequence: !input hold5s_click2
              - conditions: "{{ hold_time == 10 and click_count == 1 }}"
                sequence: !input hold10s_click1
              - conditions: "{{ hold_time == 10 and click_count == 2 }}"
                sequence: !input hold10s_click2
  - choose:
      - conditions: "{{ 'combo_' in command }}"
        sequence:
          - choose:
              - conditions: "{{ command == 'combo_power_up' }}"
                sequence: !input combo_power_up
              - conditions: "{{ command == 'combo_power_down' }}"
                sequence: !input combo_power_down
              - conditions: "{{ command == 'combo_power_hue' }}"
                sequence: !input combo_power_hue
              - conditions: "{{ command == 'combo_up_down' }}"
                sequence: !input combo_up_down
              - conditions: "{{ command == 'combo_up_hue' }}"
                sequence: !input combo_up_hue
              - conditions: "{{ command == 'combo_down_hue' }}"
                sequence: !input combo_down_hue
  - variables:
      last_state: "{{ states(helper_last_controller_event) }}"
      json_state: "{{ last_state | from_json if last_state not in ['', 'None', 'unknown'] else {} }}"
      multi_press_interval: "{{ multi_press_interval | default(0.1) }}"
      current_time: "{{ now().timestamp() }}"
  - variables:
      button: "{{ command.split('_')[0] }}"
      button_info: "{{ json_state[button] if button in json_state else {} }}"
      last_time: "{{ button_info.last_time if 'last_time' in button_info else 0 }}"
      clicks: "{{ button_info.clicks if 'clicks' in button_info else 0 }}"
      new_clicks: >-
        {% if current_time - last_time <= multi_press_interval %}
          {{ clicks + 1 }}
        {% else %}
          1
        {% endif %}
      updated_button_info:
        last_time: "{{ current_time }}"
        clicks: "{{ new_clicks }}"
        hold: "{{ 'hold' in command }}"
  - variables:
      json_state: "{{ json_state | combine({button: updated_button_info}) }}"
  - service: input_text.set_value
    data:
      entity_id: !input helper_last_controller_event
      value: "{{ json_state | to_json }}"
  - choose:
      - conditions: "{{ updated_button_info.clicks == 1 and not updated_button_info.hold }}"
        sequence: !input click1
      - conditions: "{{ updated_button_info.clicks == 2 and not updated_button_info.hold }}"
        sequence: !input click2
      - conditions: "{{ updated_button_info.clicks == 3 and not updated_button_info.hold }}"
        sequence: !input click3
      - conditions: "{{ updated_button_info.clicks == 4 and not updated_button_info.hold }}"
        sequence: !input click4
      - conditions: "{{ updated_button_info.clicks == 5 and not updated_button_info.hold }}"
        sequence: !input click5
      - conditions: "{{ updated_button_info.hold and updated_button_info.clicks == 1 }}"
        sequence: !input hold_once
