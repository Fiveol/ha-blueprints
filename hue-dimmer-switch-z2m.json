blueprint:
  name: Philips Hue Dimmer Z2M
  domain: automation
  description: Full-featured Philips Hue Dimmer Z2M automation with all clicks, holds, click+hold, hold+click, and multi-button combos
  input:
    action_sensor:
      name: Action Sensor
      selector:
        entity:
          integration: mqtt
          domain: sensor
    helper_last_controller_event:
      name: Helper - Last Controller Event
      selector:
        entity:
          domain: input_text
    multi_press_interval:
      name: Multi-Press Interval (ms)
      default: 100
      selector:
        number:
          min: 10
          max: 2000
          step: 10
    power_1_click: { action: [] }
    power_2_click: { action: [] }
    power_3_click: { action: [] }
    power_4_click: { action: [] }
    power_5_click: { action: [] }
    power_6_click: { action: [] }
    power_7_click: { action: [] }
    power_8_click: { action: [] }
    power_9_click: { action: [] }
    power_10_click: { action: [] }
    power_1s_hold: { action: [] }
    power_3s_hold: { action: [] }
    power_5s_hold: { action: [] }
    power_10s_hold: { action: [] }
    power_1click_1s_hold: { action: [] }
    power_1click_3s_hold: { action: [] }
    power_1click_5s_hold: { action: [] }
    power_1click_10s_hold: { action: [] }
    power_1s_hold_1click: { action: [] }
    power_3s_hold_1click: { action: [] }
    power_5s_hold_1click: { action: [] }
    power_10s_hold_1click: { action: [] }

    up_1_click: { action: [] }
    up_2_click: { action: [] }
    up_3_click: { action: [] }
    up_4_click: { action: [] }
    up_5_click: { action: [] }
    up_6_click: { action: [] }
    up_7_click: { action: [] }
    up_8_click: { action: [] }
    up_9_click: { action: [] }
    up_10_click: { action: [] }
    up_1s_hold: { action: [] }
    up_3s_hold: { action: [] }
    up_5s_hold: { action: [] }
    up_10s_hold: { action: [] }
    up_1click_1s_hold: { action: [] }
    up_1click_3s_hold: { action: [] }
    up_1click_5s_hold: { action: [] }
    up_1click_10s_hold: { action: [] }
    up_1s_hold_1click: { action: [] }
    up_3s_hold_1click: { action: [] }
    up_5s_hold_1click: { action: [] }
    up_10s_hold_1click: { action: [] }

    down_1_click: { action: [] }
    down_2_click: { action: [] }
    down_3_click: { action: [] }
    down_4_click: { action: [] }
    down_5_click: { action: [] }
    down_6_click: { action: [] }
    down_7_click: { action: [] }
    down_8_click: { action: [] }
    down_9_click: { action: [] }
    down_10_click: { action: [] }
    down_1s_hold: { action: [] }
    down_3s_hold: { action: [] }
    down_5s_hold: { action: [] }
    down_10s_hold: { action: [] }
    down_1click_1s_hold: { action: [] }
    down_1click_3s_hold: { action: [] }
    down_1click_5s_hold: { action: [] }
    down_1click_10s_hold: { action: [] }
    down_1s_hold_1click: { action: [] }
    down_3s_hold_1click: { action: [] }
    down_5s_hold_1click: { action: [] }
    down_10s_hold_1click: { action: [] }

    hue_1_click: { action: [] }
    hue_2_click: { action: [] }
    hue_3_click: { action: [] }
    hue_4_click: { action: [] }
    hue_5_click: { action: [] }
    hue_6_click: { action: [] }
    hue_7_click: { action: [] }
    hue_8_click: { action: [] }
    hue_9_click: { action: [] }
    hue_10_click: { action: [] }
    hue_1s_hold: { action: [] }
    hue_3s_hold: { action: [] }
    hue_5s_hold: { action: [] }
    hue_10s_hold: { action: [] }
    hue_1click_1s_hold: { action: [] }
    hue_1click_3s_hold: { action: [] }
    hue_1click_5s_hold: { action: [] }
    hue_1click_10s_hold: { action: [] }
    hue_1s_hold_1click: { action: [] }
    hue_3s_hold_1click: { action: [] }
    hue_5s_hold_1click: { action: [] }
    hue_10s_hold_1click: { action: [] }

    power_up: { action: [] }
    power_down: { action: [] }
    power_hue: { action: [] }
    hue_up: { action: [] }
    hue_down: { action: [] }
    power_hue_up: { action: [] }
    power_hue_down: { action: [] }
    power_hue_up_down: { action: [] }

trigger:
  - platform: state
    entity_id: !input action_sensor

mode: restart
max_exceeded: silent

action:
  - variables:
      last_state: "{{ states(input_text.helper_last_controller_event) }}"
      json_state: "{{ last_state | from_json if last_state not in ['', 'None', 'unknown'] else {} }}"
      multi_press_interval: "{{ multi_press_interval / 1000 }}"
      command: "{{ trigger.to_state.state }}"
      current_time: "{{ now().timestamp() }}"
      button: "{{ command.split('_')[0] }}"
      button_info: "{{ json_state[button] if button in json_state else {} }}"
      last_time: "{{ button_info.last_time if 'last_time' in button_info else 0 }}"
      clicks: "{{ button_info.clicks if 'clicks' in button_info else 0 }}"
      new_clicks: >-
        {% if current_time - last_time <= multi_press_interval %}
          {{ clicks + 1 }}
        {% else %}
          1
        {% endif %}
      updated_button_info:
        last_time: "{{ current_time }}"
        clicks: "{{ new_clicks }}"
        hold: "{{ 'hold' in command }}"
      json_state: "{{ json_state | combine({button: updated_button_info}) }}"
  - service: input_text.set_value
    data:
      entity_id: !input helper_last_controller_event
      value: "{{ json_state | to_json }}"
  - choose:
      - conditions: "{{ updated_button_info.clicks == 1 and not updated_button_info.hold }}"
        sequence: !input "{{ button }}_1_click"
      - conditions: "{{ updated_button_info.clicks == 2 and not updated_button_info.hold }}"
        sequence: !input "{{ button }}_2_click"
      - conditions: "{{ updated_button_info.clicks == 3 and not updated_button_info.hold }}"
        sequence: !input "{{ button }}_3_click"
      - conditions: "{{ updated_button_info.clicks == 4 and not updated_button_info.hold }}"
        sequence: !input "{{ button }}_4_click"
      - conditions: "{{ updated_button_info.clicks == 5 and not updated_button_info.hold }}"
        sequence: !input "{{ button }}_5_click"
      - conditions: "{{ updated_button_info.clicks == 6 and not updated_button_info.hold }}"
        sequence: !input "{{ button }}_6_click"
      - conditions: "{{ updated_button_info.clicks == 7 and not updated_button_info.hold }}"
        sequence: !input "{{ button }}_7_click"
      - conditions: "{{ updated_button_info.clicks == 8 and not updated_button_info.hold }}"
        sequence: !input "{{ button }}_8_click"
      - conditions: "{{ updated_button_info.clicks == 9 and not updated_button_info.hold }}"
        sequence: !input "{{ button }}_9_click"
      - conditions: "{{ updated_button_info.clicks == 10 and not updated_button_info.hold }}"
        sequence: !input "{{ button }}_10_click"
      - conditions: "{{ updated_button_info.hold }}"
        sequence:
          - choose:
              - conditions: "'1s_hold' in command"
                sequence: !input "{{ button }}_1s_hold"
              - conditions: "'3s_hold' in command"
                sequence: !input "{{ button }}_3s_hold"
              - conditions: "'5s_hold' in command"
                sequence: !input "{{ button }}_5s_hold"
              - conditions: "'10s_hold' in command"
                sequence: !input "{{ button }}_10s_hold"
      - conditions: "{{ '_click_' in command and '_hold' in command }}"
        sequence:
          - choose:
              - conditions: "'1click_1s_hold' in command"
                sequence: !input "{{ button }}_1click_1s_hold"
              - conditions: "'1click_3s_hold' in command"
                sequence: !input "{{ button }}_1click_3s_hold"
              - conditions: "'1click_5s_hold' in command"
                sequence: !input "{{ button }}_1click_5s_hold"
              - conditions: "'1click_10s_hold' in command"
                sequence: !input "{{ button }}_1click_10s_hold"
      - conditions: "{{ '_hold_' in command and '_click' in command }}"
        sequence:
          - choose:
              - conditions: "'1s_hold_1click' in command"
                sequence: !input "{{ button }}_1s_hold_1click"
              - conditions: "'3s_hold_1click' in command"
                sequence: !input "{{ button }}_3s_hold_1click"
              - conditions: "'5s_hold_1click' in command"
                sequence: !input "{{ button }}_5s_hold_1click"
              - conditions: "'10s_hold_1click' in command"
                sequence: !input "{{ button }}_10s_hold_1click"
      - conditions: "{{ 'combo' in command or '_' in command }}"
        sequence:
          - choose:
              - conditions: "'power_up' in command"
                sequence: !input power_up
              - conditions: "'power_down' in command"
                sequence: !input power_down
              - conditions: "'power_hue' in command"
                sequence: !input power_hue
              - conditions: "'hue_up' in command"
                sequence: !input hue_up
              - conditions: "'hue_down' in command"
                sequence: !input hue_down
              - conditions: "'power_hue_up' in command"
                sequence: !input power_hue_up
              - conditions: "'power_hue_down' in command"
                sequence: !input power_hue_down
              - conditions: "'power_hue_up_down' in command"
                sequence: !input power_hue_up_down
