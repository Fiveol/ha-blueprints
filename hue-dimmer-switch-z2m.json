      default: []
      selector: {action: {}}
    on_7:
      name: ON - 7 Clicks
      default: []
      selector: {action: {}}
    on_8:
      name: ON - 8 Clicks
      default: []
      selector: {action: {}}
    on_9:
      name: ON - 9 Clicks
      default: []
      selector: {action: {}}
    on_10:
      name: ON - 10 Clicks
      default: []
      selector: {action: {}}
    on_hold:
      name: ON - Hold
      default: []
      selector: {action: {}}
    on_hold_release:
      name: ON - Hold Release
      default: []
      selector: {action: {}}
    up_1:
      name: UP - 1 Click
      default: []
      selector: {action: {}}
    up_2:
      name: UP - 2 Clicks
      default: []
      selector: {action: {}}
    up_3:
      name: UP - 3 Clicks
      default: []
      selector: {action: {}}
    up_4:
      name: UP - 4 Clicks
      default: []
      selector: {action: {}}
    up_5:
      name: UP - 5 Clicks
      default: []
      selector: {action: {}}
    up_6:
      name: UP - 6 Clicks
      default: []
      selector: {action: {}}
    up_7:
      name: UP - 7 Clicks
      default: []
      selector: {action: {}}
    up_8:
      name: UP - 8 Clicks
      default: []
      selector: {action: {}}
    up_9:
      name: UP - 9 Clicks
      default: []
      selector: {action: {}}
    up_10:
      name: UP - 10 Clicks
      default: []
      selector: {action: {}}
