      - conditions: '{{ command == "power_1s_hold_1_click" }}'
        sequence: !input power_1s_hold_1_click
      - conditions: '{{ command == "power_3s_hold_1_click" }}'
        sequence: !input power_3s_hold_1_click
      - conditions: '{{ command == "power_5s_hold_1_click" }}'
