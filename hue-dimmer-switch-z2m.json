    off_hold_release:
      name: OFF - Hold Release
      default: []
      selector: {action: {}}

mode: restart
max_exceeded: silent

trigger:
  - platform: state
    entity_id: !input event_entity

action:
  - variables:
      # Reads directly from the event payload attribute instead of a separate sensor entity
      raw_state: "{{ trigger.to_state.attributes.event_type | default('') }}"
      helper: !input counter_helper

  - choose:
      - conditions: "{{ 'hold' in raw_state and 'release' not in raw_state }}"
        sequence:
          - choose:
              - conditions: "{{ 'on' in raw_state }}"
                sequence: !input on_hold
              - conditions: "{{ 'up' in raw_state }}"
                sequence: !input up_hold
              - conditions: "{{ 'down' in raw_state }}"
                sequence: !input down_hold
              - conditions: "{{ 'off' in raw_state }}"
                sequence: !input off_hold
      - conditions: "{{ 'hold_release' in raw_state }}"
        sequence:
          - choose:
              - conditions: "{{ 'on' in raw_state }}"
                sequence: !input on_hold_release
              - conditions: "{{ 'up' in raw_state }}"
                sequence: !input up_hold_release
              - conditions: "{{ 'down' in raw_state }}"
                sequence: !input down_hold_release
              - conditions: "{{ 'off' in raw_state }}"
                sequence: !input off_hold_release
      - conditions: "{{ 'press_release' in raw_state }}"
        sequence:
          - variables:
              new_count: "{{ (states(helper) | int(0)) + 1 }}"
          - action: input_text.set_value
            target:
              entity_id: !input counter_helper
            data:
              value: "{{ new_count }}"
          - delay:
              milliseconds: !input click_delay
          - variables:
              final_count: "{{ states(helper) | int(0) }}"
              btn: "{{ raw_state.split('_')[0] }}"
          - choose:
              - conditions: "{{ btn == 'on' }}"
                sequence:
                  - choose:
                      - conditions: "{{ final_count == 1 }}"
                        sequence: !input on_1
                      - conditions: "{{ final_count == 2 }}"
                        sequence: !input on_2
                      - conditions: "{{ final_count == 3 }}"
                        sequence: !input on_3
                      - conditions: "{{ final_count == 4 }}"
                        sequence: !input on_4
                      - conditions: "{{ final_count == 5 }}"
                        sequence: !input on_5
                      - conditions: "{{ final_count == 6 }}"
                        sequence: !input on_6
                      - conditions: "{{ final_count == 7 }}"
                        sequence: !input on_7
                      - conditions: "{{ final_count == 8 }}"
                        sequence: !input on_8
                      - conditions: "{{ final_count == 9 }}"
                        sequence: !input on_9
                      - conditions: "{{ final_count == 10 }}"
                        sequence: !input on_10
              - conditions: "{{ btn == 'up' }}"
                sequence:
                  - choose:
                      - conditions: "{{ final_count == 1 }}"
                        sequence: !input up_1
                      - conditions: "{{ final_count == 2 }}"
                        sequence: !input up_2
                      - conditions: "{{ final_count == 3 }}"
                        sequence: !input up_3
                      - conditions: "{{ final_count == 4 }}"
                        sequence: !input up_4
                      - conditions: "{{ final_count == 5 }}"
                        sequence: !input up_5
                      - conditions: "{{ final_count == 6 }}"
                        sequence: !input up_6
                      - conditions: "{{ final_count == 7 }}"
                        sequence: !input up_7
                      - conditions: "{{ final_count == 8 }}"
                        sequence: !input up_8
                      - conditions: "{{ final_count == 9 }}"
                        sequence: !input up_9
                      - conditions: "{{ final_count == 10 }}"
                        sequence: !input up_10
              - conditions: "{{ btn == 'down' }}"
                sequence:
                  - choose:
                      - conditions: "{{ final_count == 1 }}"
                        sequence: !input down_1
                      - conditions: "{{ final_count == 2 }}"
                        sequence: !input down_2
                      - conditions: "{{ final_count == 3 }}"
                        sequence: !input down_3
                      - conditions: "{{ final_count == 4 }}"
                        sequence: !input down_4
                      - conditions: "{{ final_count == 5 }}"
                        sequence: !input down_5
                      - conditions: "{{ final_count == 6 }}"
                        sequence: !input down_6
                      - conditions: "{{ final_count == 7 }}"
                        sequence: !input down_7
                      - conditions: "{{ final_count == 8 }}"
                        sequence: !input down_8
                      - conditions: "{{ final_count == 9 }}"
                        sequence: !input down_9
                      - conditions: "{{ final_count == 10 }}"
                        sequence: !input down_10
              - conditions: "{{ btn == 'off' }}"
                sequence:
                  - choose:
                      - conditions: "{{ final_count == 1 }}"
                        sequence: !input off_1
                      - conditions: "{{ final_count == 2 }}"
                        sequence: !input off_2
                      - conditions: "{{ final_count == 3 }}"
                        sequence: !input off_3
                      - conditions: "{{ final_count == 4 }}"
                        sequence: !input off_4
                      - conditions: "{{ final_count == 5 }}"
                        sequence: !input off_5
                      - conditions: "{{ final_count == 6 }}"
                        sequence: !input off_6
                      - conditions: "{{ final_count == 7 }}"
                        sequence: !input off_7
                      - conditions: "{{ final_count == 8 }}"
                        sequence: !input off_8
                      - conditions: "{{ final_count == 9 }}"
                        sequence: !input off_9
                      - conditions: "{{ final_count == 10 }}"
                        sequence: !input off_10
          - action: input_text.set_value
            target:
              entity_id: !input counter_helper
            data:
              value: "0"
