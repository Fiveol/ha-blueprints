blueprint:
  name: Philips Hue Dimmer Z2M (Event-based)
  domain: automation
  input:
    event_entity:
      name: Event Entity
      description: The 'event.' entity corresponding to your Hue switch.
      selector:
        entity:
          domain: event
    counter_helper:
      name: Counter Helper
      description: An input_text helper used to track multi-click counts.
      selector:
        entity:
          domain: input_text
    click_delay:
      name: Click Speed
      default: 300
      selector:
        number:
          min: 50
          max: 1000
          unit_of_measurement: ms
    on_1:
      name: ON - 1 Click
      default: []
      selector: {action: {}}
    on_2:
      name: ON - 2 Clicks
      default: []
      selector: {action: {}}
    on_3:
      name: ON - 3 Clicks
      default: []
      selector: {action: {}}
