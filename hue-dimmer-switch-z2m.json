blueprint:
  name: Philips Hue Dimmer Z2M
  description: >
    Advanced Philips Hue Dimmer Switch (Zigbee2MQTT) blueprint with:
    - Press, 1-10 clicks
    - 1/3/5/10s holds
    - Single click + hold
    - Hold + single click
    - Button combinations (Power, Up, Down, Hue)
  domain: automation
  input:
    action_sensor:
      name: Action Sensor
      description: Zigbee2mqtt Hue Dimmer action
      selector:
        entity:
          integration: mqtt
          domain: sensor
          multiple: false
    helper_last_controller_event:
      name: Helper - Last Controller Event
      description: >
        Input Text used to store the last event fired by the controller.
        You will need to manually create a text input Helper entity for this.
      selector:
        entity:
          domain: input_text
          multiple: false

    # --------------------------------
    # POWER BUTTON
    # --------------------------------
    power_press: { name: Power press, default: [], selector: { action: {} } }
    power_1_click: { name: Power 1 click, default: [], selector: { action: {} } }
