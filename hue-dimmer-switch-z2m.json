blueprint:
  name: Philips Hue Dimmer Z2M
  description: >
    Philips Hue Dimmer Switch (Zigbee2MQTT) with advanced click and hold options.
    Supports:
      - Initial press
      - 1 to 10 clicks
      - 1, 3, 5, 10 second holds
      - Single click + hold combinations
      - Hold + single click combinations
      - Button combinations (Power + Up, Power + Down, etc.)

  domain: automation
  input:
    action_sensor:
      name: Action Sensor
      description: Zigbee2mqtt Hue Dimmer action
      selector:
        entity:
          integration: mqtt
          domain: sensor
          multiple: false

    helper_last_controller_event:
      name: (Required) Helper - Last Controller Event
      description: >
        Input Text used to store the last event fired by the controller.
        Manually create a text input Helper entity for this.
      default: ""
      selector:
        entity:
          domain: input_text
          multiple: false

# Define inputs for each button and type
# We'll generate them programmatically for clarity
# Buttons: power, up, down, hue
# Events: press, 1-10 clicks, hold 1/3/5/10 sec, combinations with clicks

# --- Button Events ---
# Example for one button: power
# Repeat for up, down, hue

  input:
    {% for btn in ["power", "up", "down", "hue"] %}
    {{btn}}_press:
      name: {{btn | capitalize}} button press
      default: []
      selector:
        action: {}
    {% for i in range(1,11) %}
    {{btn}}_{{i}}_clicks:
      name: {{btn | capitalize}} button {{i}} clicks
      default: []
      selector:
        action: {}
    {% endfor %}
    {% for sec in [1,3,5,10] %}
    {{btn}}_hold_{{sec}}:
      name: {{btn | capitalize}} button {{sec}} second hold
      default: []
      selector:
        action: {}
    {% endfor %}
    {% for sec in [1,3,5,10] %}
    {{btn}}_click_{{sec}}_hold:
      name: {{btn | capitalize}} button single click + {{sec}} second hold
      default: []
      selector:
        action: {}
    {{btn}}_hold_{{sec}}_click:
      name: {{btn | capitalize}} button {{sec}} second hold + single click
      default: []
      selector:
        action: {}
    {% endfor %}
    {% endfor %}

# --- Button Combinations ---
  input:
    power_up:
      name: Power + Up combination
      default: []
      selector:
        action: {}
    power_down:
      name: Power + Down combination
      default: []
      selector:
        action: {}
    power_hue:
      name: Power + Hue combination
      default: []
      selector:
        action: {}
    hue_up:
      name: Hue + Up combination
      default: []
      selector:
        action: {}
    hue_down:
      name: Hue + Down combination
      default: []
      selector:
        action: {}
    power_hue_up:
      name: Power + Hue + Up combination
      default: []
      selector:
        action: {}
    power_hue_down:
      name: Power + Hue + Down combination
      default: []
      selector:
        action: {}
    power_hue_up_down:
      name: Power + Hue + Up + Down combination
      default: []
      selector:
        action: {}

mode: restart
max_exceeded: silent

trigger:
  - platform: event
    event_type: state_changed
    event_data:
      entity_id: !input action_sensor

condition:
  - condition: template
    value_template: '{{ trigger.event.data.new_state.state not in ("", "None", "unknown") }}'

action:
  - variables:
      helper_last_controller_event: !input helper_last_controller_event
      command: "{{ trigger.event.data.new_state.state }}"
      prev_command: "{{ states(helper_last_controller_event) }}"
  - service: input_text.set_value
    data:
      entity_id: !input helper_last_controller_event
      value: "{{ command }}"
  - choose:
      # Dynamically dispatch the command to the correct action
      - conditions: '{{ command == "power_press" }}'
        sequence: !input power_press
      - conditions: '{{ command == "power_1_clicks" }}'
        sequence: !input power_1_clicks
      # ... continue for all button events and combinations
