    down_4:
      name: DOWN - 4 Clicks
      default: []
      selector: {action: {}}
    down_5:
      name: DOWN - 5 Clicks
      default: []
      selector: {action: {}}
    down_6:
      name: DOWN - 6 Clicks
      default: []
      selector: {action: {}}
    down_7:
      name: DOWN - 7 Clicks
