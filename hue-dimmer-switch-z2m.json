blueprint:
  name: Philips Hue Dimmer v2 (Z2M) - Multi-Click Engine
  description: >
    Extends the Hue Dimmer V2 to support up to 5 clicks using a Text Helper to track state.
    Note: Multi-click introduces a small delay (the timeout) before the action executes.
  domain: automation
  input:
    action_sensor:
      name: Action Sensor
      selector:
        entity:
          integration: mqtt
          domain: sensor
    helper_last_event:
      name: Text Helper
      description: Create a Text Helper (input_text) to store click count and timing.
      selector:
        entity:
          domain: input_text
    click_timeout:
      name: Click Speed
      description: Max time (milliseconds) between clicks to count as a multi-click.
      default: 500
      selector:
        number:
          min: 200
          max: 1000
          unit_of_measurement: ms
    # Example Actions for ON button
    on_single:
      name: ON - Single Press
      default: []
      selector: {action: {}}
    on_double:
      name: ON - Double Press
      default: []
      selector: {action: {}}
    on_triple:
      name: ON - Triple Press
      default: []
      selector: {action: {}}

mode: restart # Important: Restarts on every click to reset the "Wait" timer

trigger:
  - platform: state
    entity_id: !input action_sensor

condition:
  - condition: template
    # Only trigger on 'press' events, ignore 'release' or 'hold' for the click counter
    value_template: "{{ 'press' in states(trigger.entity_id) and 'release' not in states(trigger.entity_id) }}"

action:
  - variables:
      helper: !input helper_last_event
      # Parse the JSON from our helper or set defaults
      last_data: >
        {% set val = states(helper) %}
        {{ val if val != 'unknown' and val != '' else '{"count":0, "last_time":0, "button":""}' }}
      last_count: "{{ (last_data | from_json).count | int }}"
      last_time: "{{ (last_data | from_json).last_time | float }}"
      last_button: "{{ (last_data | from_json).button }}"
      current_button: "{{ states(trigger.entity_id).split('_')[0] }}"
      now_ms: "{{ as_timestamp(now()) * 1000 }}"
      timeout: !input click_timeout

  - variant: >
      {% set new_count = (last_count + 1) if (now_ms - last_time < timeout and last_button == current_button) else 1 %}
      {% set new_data = {'count': new_count, 'last_time': now_ms, 'button': current_button} %}
      {{ new_data | to_json }}
    service: input_text.set_value
    target:
      entity_id: !input helper_last_event
    data:
      value: "{{ new_data }}"

  # Wait to see if another click comes in
  - delay:
      milliseconds: !input click_timeout

  # If we got here without the automation being "restarted" by a new click, execute
  - variables:
      final_data: "{{ states(helper) | from_json }}"
      final_count: "{{ final_data.count }}"
      final_button: "{{ final_data.button }}"

  - choose:
      # ON BUTTON LOGIC
      - conditions: "{{ final_button == 'on' }}"
        sequence:
          - choose:
              - conditions: "{{ final_count == 1 }}"
                sequence: !input on_single
              - conditions: "{{ final_count == 2 }}"
                sequence: !input on_double
              - conditions: "{{ final_count == 3 }}"
                sequence: !input on_triple

  # Reset helper after execution so the next press starts fresh
  - service: input_text.set_value
    target:
      entity_id: !input helper_last_event
    data:
      value: '{"count":0, "last_time":0, "button":""}'
