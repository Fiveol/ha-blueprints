    off_3:
      name: OFF - 3 Clicks
      default: []
      selector: {action: {}}
    off_4:
      name: OFF - 4 Clicks
      default: []
      selector: {action: {}}
    off_5:
      name: OFF - 5 Clicks
      default: []
      selector: {action: {}}
    off_6:
      name: OFF - 6 Clicks
      default: []
      selector: {action: {}}
    off_7:
      name: OFF - 7 Clicks
      default: []
