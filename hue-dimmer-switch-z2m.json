blueprint:
  name: Hue Dimmer Switch Z2M (God Mode) - Full
  description: "Advanced logic for Hue Dimmer V2. Supports 5 clicks per button, multiple hold levels, and hybrid click-hold sequences."
  domain: automation
  input:
    action_sensor:
      name: Action Sensor
      selector:
        entity:
          domain: sensor
    helper_last_event:
      name: Text Helper (Input Text)
      selector:
        entity:
          domain: input_text
    click_delay:
      name: Multi-click Delay
      default: 350
      selector:
        number:
          min: 150
          max: 1000
          unit_of_measurement: ms

    # --- ACTIONS: ON ---
    on_initial_press:
      name: ON - Initial Press
      default: []
      selector: { action: {} }
    on_click_1:
      name: ON - Click 1
      default: []
      selector: { action: {} }
    on_click_2:
      name: ON - Click 2
      default: []
      selector: { action: {} }
    on_click_3:
      name: ON - Click 3
      default: []
      selector: { action: {} }
    on_click_4:
      name: ON - Click 4
      default: []
      selector: { action: {} }
    on_click_5:
      name: ON - Click 5
      default: []
      selector: { action: {} }
    on_hold_1s:
      name: ON - Hold 1s
      default: []
      selector: { action: {} }
    on_hold_5s:
      name: ON - Hold 5s
      default: []
      selector: { action: {} }
    on_hold_10s:
      name: ON - Hold 10s
      default: []
      selector: { action: {} }
    on_click_hold_1s:
      name: ON - Click then Hold
      default: []
      selector: { action: {} }
    on_hold_1s_click:
      name: ON - Hold then Click
      default: []
      selector: { action: {} }

    # --- ACTIONS: UP ---
    up_initial_press:
      name: UP - Initial Press
      default: []
      selector: { action: {} }
    up_click_1:
      name: UP - Click 1
      default: []
      selector: { action: {} }
    up_click_2:
      name: UP - Click 2
      default: []
      selector: { action: {} }
    up_click_3:
      name: UP - Click 3
      default: []
      selector: { action: {} }
    up_click_4:
      name: UP - Click 4
      default: []
      selector: { action: {} }
    up_click_5:
      name: UP - Click 5
      default: []
      selector: { action: {} }
    up_hold_1s:
      name: UP - Hold 1s
      default: []
      selector: { action: {} }
    up_hold_5s:
      name: UP - Hold 5s
      default: []
      selector: { action: {} }
    up_hold_10s:
      name: UP - Hold 10s
      default: []
      selector: { action: {} }
    up_click_hold_1s:
      name: UP - Click then Hold
      default: []
      selector: { action: {} }
    up_hold_1s_click:
      name: UP - Hold then Click
      default: []
      selector: { action: {} }

    # --- ACTIONS: DOWN ---
    down_initial_press:
      name: DOWN - Initial Press
      default: []
      selector: { action: {} }
    down_click_1:
      name: DOWN - Click 1
      default: []
      selector: { action: {} }
    down_click_2:
      name: DOWN - Click 2
      default: []
      selector: { action: {} }
    down_click_3:
      name: DOWN - Click 3
      default: []
      selector: { action: {} }
    down_click_4:
      name: DOWN - Click 4
      default: []
      selector: { action: {} }
    down_click_5:
      name: DOWN - Click 5
      default: []
      selector: { action: {} }
    down_hold_1s:
      name: DOWN - Hold 1s
      default: []
      selector: { action: {} }
    down_hold_5s:
      name: DOWN - Hold 5s
      default: []
      selector: { action: {} }
    down_hold_10s:
      name: DOWN - Hold 10s
      default: []
      selector: { action: {} }
    down_click_hold_1s:
      name: DOWN - Click then Hold
      default: []
      selector: { action: {} }
    down_hold_1s_click:
      name: DOWN - Hold then Click
      default: []
      selector: { action: {} }

    # --- ACTIONS: OFF ---
    off_initial_press:
      name: OFF - Initial Press
      default: []
      selector: { action: {} }
    off_click_1:
      name: OFF - Click 1
      default: []
      selector: { action: {} }
    off_click_2:
      name: OFF - Click 2
      default: []
      selector: { action: {} }
    off_click_3:
      name: OFF - Click 3
      default: []
      selector: { action: {} }
    off_click_4:
      name: OFF - Click 4
      default: []
      selector: { action: {} }
    off_click_5:
      name: OFF - Click 5
      default: []
      selector: { action: {} }
    off_hold_1s:
      name: OFF - Hold 1s
      default: []
      selector: { action: {} }
    off_hold_5s:
      name: OFF - Hold 5s
      default: []
      selector: { action: {} }
    off_hold_10s:
      name: OFF - Hold 10s
      default: []
      selector: { action: {} }
    off_click_hold_1s:
      name: OFF - Click then Hold
      default: []
      selector: { action: {} }
    off_hold_1s_click:
      name: OFF - Hold then Click
      default: []
      selector: { action: {} }

mode: restart
max_exceeded: silent

trigger:
  - platform: state
    entity_id: !input action_sensor

condition:
  - condition: template
    value_template: "{{ trigger.to_state.state not in ['', 'None', 'unknown', 'unavailable'] }}"

action:
  - variables:
      command: "{{ trigger.to_state.state }}"
      button: "{{ command.split('_')[0] }}"
      type: "{{ command.split('_')[1] }}"
      helper: !input helper_last_event
      delay_val: !input click_delay
      raw_data: "{{ states(helper) }}"
      json_data: >
        {% if raw_data is defined and '{' in raw_data %}
          {{ raw_data | from_json }}
        {% else %}
          {"count": 0, "last_time": 0, "btn": "none", "cmd": "none"}
        {% endif %}
      now_ms: "{{ as_timestamp(now()) * 1000 }}"
      is_rapid: "{{ (now_ms - json_data.last_time) < (delay_val + 150) }}"
      is_same_btn: "{{ button == json_data.btn }}"
      new_count: >
        {% if type == 'press' and is_rapid and is_same_btn and json_data.cmd == 'press' %}
          {{ [json_data.count + 1, 5] | min }}
        {% else %}
          1
        {% endif %}

  - action: input_text.set_value
    target:
      entity_id: !input helper_last_event
    data:
      value: >
        {"count": {{ new_count }}, "last_time": {{ now_ms }}, "btn": "{{ button }}", "cmd": "{{ type }}"}

  - choose:
      - conditions: "{{ type == 'press' }}"
        sequence:
          - choose:
              - conditions: "{{ button == 'on' }}"
                sequence: !input on_initial_press
              - conditions: "{{ button == 'up' }}"
                sequence: !input up_initial_press
              - conditions: "{{ button == 'down' }}"
                sequence: !input down_initial_press
              - conditions: "{{ button == 'off' }}"
                sequence: !input off_initial_press

  - choose:
      # --- HOLD LOGIC ---
      - conditions: "{{ type == 'hold' }}"
        sequence:
          - wait_for_trigger:
              - platform: state
                entity_id: !input action_sensor
                state: "{{ button }}_hold_release"
            timeout: "00:00:11"
          - variables:
              hold_dur: "{{ (as_timestamp(now()) * 1000 - now_ms) / 1000 }}"
          - action: input_text.set_value
            target:
              entity_id: !input helper_last_event
            data:
              value: '{"count": 0, "last_time": {{ as_timestamp(now()) * 1000 }}, "btn": "{{ button }}", "cmd": "hold_release"}'
          - choose:
              - conditions: "{{ is_rapid and is_same_btn and json_data.cmd == 'press' }}"
                sequence:
                  - choose:
                      - conditions: "{{ button == 'on' }}"
                        sequence: !input on_click_hold_1s
                      - conditions: "{{ button == 'up' }}"
                        sequence: !input up_click_hold_1s
                      - conditions: "{{ button == 'down' }}"
                        sequence: !input down_click_hold_1s
                      - conditions: "{{ button == 'off' }}"
                        sequence: !input off_click_hold_1s
              - conditions: "{{ hold_dur >= 10 }}"
                sequence:
                  - choose:
                      - conditions: "{{ button == 'on' }}"
                        sequence: !input on_hold_10s
                      - conditions: "{{ button == 'up' }}"
                        sequence: !input up_hold_10s
                      - conditions: "{{ button == 'down' }}"
                        sequence: !input down_hold_10s
                      - conditions: "{{ button == 'off' }}"
                        sequence: !input off_hold_10s
              - conditions: "{{ hold_dur >= 5 }}"
                sequence:
                  - choose:
                      - conditions: "{{ button == 'on' }}"
                        sequence: !input on_hold_5s
                      - conditions: "{{ button == 'up' }}"
                        sequence: !input up_hold_5s
                      - conditions: "{{ button == 'down' }}"
                        sequence: !input down_hold_5s
                      - conditions: "{{ button == 'off' }}"
                        sequence: !input off_hold_5s
              - conditions: "{{ hold_dur >= 1 }}"
                sequence:
                  - choose:
                      - conditions: "{{ button == 'on' }}"
                        sequence: !input on_hold_1s
                      - conditions: "{{ button == 'up' }}"
                        sequence: !input up_hold_1s
                      - conditions: "{{ button == 'down' }}"
                        sequence: !input down_hold_1s
                      - conditions: "{{ button == 'off' }}"
                        sequence: !input off_hold_1s

      # --- MULTI-CLICK & SEQUENCES ---
      - conditions: "{{ type == 'press' }}"
        sequence:
          - choose:
              - conditions: "{{ is_rapid and is_same_btn and json_data.cmd == 'hold_release' }}"
                sequence:
                  - choose:
                      - conditions: "{{ button == 'on' }}"
                        sequence: !input on_hold_1s_click
                      - conditions: "{{ button == 'up' }}"
                        sequence: !input up_hold_1s_click
                      - conditions: "{{ button == 'down' }}"
                        sequence: !input down_hold_1s_click
                      - conditions: "{{ button == 'off' }}"
                        sequence: !input off_hold_1s_click
          - delay:
              milliseconds: "{{ delay_val }}"
          - condition: template
            value_template: "{{ (states(helper) | from_json).count == new_count }}"
          - choose:
              - conditions: "{{ button == 'on' }}"
                sequence:
                  - choose:
                      - conditions: "{{ new_count == 1 }}"
                        sequence: !input on_click_1
                      - conditions: "{{ new_count == 2 }}"
                        sequence: !input on_click_2
                      - conditions: "{{ new_count == 3 }}"
                        sequence: !input on_click_3
                      - conditions: "{{ new_count == 4 }}"
                        sequence: !input on_click_4
                      - conditions: "{{ new_count == 5 }}"
                        sequence: !input on_click_5
              - conditions: "{{ button == 'up' }}"
                sequence:
                  - choose:
                      - conditions: "{{ new_count == 1 }}"
                        sequence: !input up_click_1
                      - conditions: "{{ new_count == 2 }}"
                        sequence: !input up_click_2
                      - conditions: "{{ new_count == 3 }}"
                        sequence: !input up_click_3
                      - conditions: "{{ new_count == 4 }}"
                        sequence: !input up_click_4
                      - conditions: "{{ new_count == 5 }}"
                        sequence: !input up_click_5
              - conditions: "{{ button == 'down' }}"
                sequence:
                  - choose:
                      - conditions: "{{ new_count == 1 }}"
                        sequence: !input down_click_1
                      - conditions: "{{ new_count == 2 }}"
                        sequence: !input down_click_2
                      - conditions: "{{ new_count == 3 }}"
                        sequence: !input down_click_3
                      - conditions: "{{ new_count == 4 }}"
                        sequence: !input down_click_4
                      - conditions: "{{ new_count == 5 }}"
                        sequence: !input down_click_5
              - conditions: "{{ button == 'off' }}"
                sequence:
                  - choose:
                      - conditions: "{{ new_count == 1 }}"
                        sequence: !input off_click_1
                      - conditions: "{{ new_count == 2 }}"
                        sequence: !input off_click_2
                      - conditions: "{{ new_count == 3 }}"
                        sequence: !input off_click_3
                      - conditions: "{{ new_count == 4 }}"
                        sequence: !input off_click_4
                      - conditions: "{{ new_count == 5 }}"
                        sequence: !input off_click_5
