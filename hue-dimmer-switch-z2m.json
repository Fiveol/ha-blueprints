blueprint:
  name: Andrew's Multi-Click Engine (Sensor/Event Hybrid)
  description: >
    A simple, fast multi-click engine.
    Triggers on 'event', validates via 'sensor'.
    Requires a Text Helper to store the click count.
  domain: automation
  input:
    event_entity:
      name: Event Entity
      description: The event entity to trigger on.
      selector:
        entity:
          domain: event
    sensor_entity:
      name: Sensor Entity
      description: The sensor entity to check for "press" state.
      selector:
        entity:
          domain: sensor
    counter_helper:
      name: Counter Helper
      description: An input_text helper to store the count (e.g., 1, 2, 3).
      selector:
        entity:
          domain: input_text
    click_delay:
      name: Click Speed
      description: Time to wait for the next click (milliseconds).
      default: 100
      selector:
        number:
          min: 50
          max: 1000
          unit_of_measurement: ms
    single_click_action:
      name: Single Click Action
      default: []
      selector: {action: {}}
    double_click_action:
      name: Double Click Action
      default: []
      selector: {action: {}}
    triple_click_action:
      name: Triple Click Action
      default: []
      selector: {action: {}}

mode: restart
max_exceeded: silent

trigger:
  - platform: state
    entity_id: !input event_entity

condition:
  - condition: template
    value_template: >-
      {{ 'press' in states(sensor_input) and 'release' not in states(sensor_input) }}
    variables:
      sensor_input: !input sensor_entity

action:
  - variables:
      helper: !input counter_helper
      current_count: "{{ states(helper) | int(0) }}"
      new_count: "{{ current_count + 1 }}"

  # Increment Helper
  - action: input_text.set_value
    target:
      entity_id: !input counter_helper
    data:
      value: "{{ new_count }}"

  # Wait for more clicks
  - delay:
      milliseconds: !input click_delay

  # Final Count Check
  - variables:
      final_count: "{{ states(helper) | int(0) }}"

  - choose:
      - conditions: "{{ final_count == 1 }}"
        sequence: !input single_click_action
      - conditions: "{{ final_count == 2 }}"
        sequence: !input double_click_action
      - conditions: "{{ final_count == 3 }}"
        sequence: !input triple_click_action

  # Reset Helper to 0
  - action: input_text.set_value
    target:
      entity_id: !input counter_helper
    data:
      value: "0"
