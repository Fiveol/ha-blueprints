blueprint:
  name: Philips Hue Dimmer Z2M (Event Entity)
  description: Assign actions to a Philips Hue Dimmer switch using its Home Assistant Event entity.
  domain: automation
  input:
    switch_event_entity:
      name: Dimmer Switch Event Entity
      description: Select the event entity for your switch (e.g., event.andrew_room_switch_action).
      selector:
        entity:
          domain: event

    # ON BUTTON
    on_press:
      name: On Button - Press
      default: []
      selector:
        action: {}
    on_press_release:
      name: On Button - Press Release
      default: []
      selector:
        action: {}
    on_hold:
      name: On Button - Hold
      default: []
      selector:
        action: {}
    on_hold_release:
      name: On Button - Hold Release
      default: []
      selector:
        action: {}

    # UP BUTTON
    up_press:
      name: Up Button - Press
      default: []
      selector:
        action: {}
    up_press_release:
      name: Up Button - Press Release
      default: []
      selector:
        action: {}
    up_hold:
      name: Up Button - Hold
      default: []
      selector:
        action: {}
    up_hold_release:
      name: Up Button - Hold Release
      default: []
      selector:
        action: {}

    # DOWN BUTTON
    down_press:
      name: Down Button - Press
      default: []
      selector:
        action: {}
    down_press_release:
      name: Down Button - Press Release
      default: []
      selector:
        action: {}
    down_hold:
      name: Down Button - Hold
      default: []
      selector:
        action: {}
    down_hold_release:
      name: Down Button - Hold Release
      default: []
      selector:
        action: {}

    # OFF BUTTON
    off_press:
      name: Off Button - Press
      default: []
      selector:
        action: {}
    off_press_release:
      name: Off Button - Press Release
      default: []
      selector:
        action: {}
    off_hold:
      name: Off Button - Hold
      default: []
      selector:
        action: {}
    off_hold_release:
      name: Off Button - Hold Release
      default: []
      selector:
        action: {}

mode: restart

trigger:
  - platform: state
    entity_id: !input switch_event_entity
    # This prevents ghost triggers when the entity goes unavailable/reconnects
    not_from:
      - unavailable
      - unknown

action:
  - choose:
      # ON BUTTON
      - conditions: "{{ trigger.to_state.attributes.event_type == 'on_press' }}"
        sequence: !input on_press
      - conditions: "{{ trigger.to_state.attributes.event_type == 'on_press_release' }}"
        sequence: !input on_press_release
      - conditions: "{{ trigger.to_state.attributes.event_type == 'on_hold' }}"
        sequence: !input on_hold
      - conditions: "{{ trigger.to_state.attributes.event_type == 'on_hold_release' }}"
        sequence: !input on_hold_release

      # UP BUTTON
      - conditions: "{{ trigger.to_state.attributes.event_type == 'up_press' }}"
        sequence: !input up_press
      - conditions: "{{ trigger.to_state.attributes.event_type == 'up_press_release' }}"
        sequence: !input up_press_release
      - conditions: "{{ trigger.to_state.attributes.event_type == 'up_hold' }}"
        sequence: !input up_hold
      - conditions: "{{ trigger.to_state.attributes.event_type == 'up_hold_release' }}"
        sequence: !input up_hold_release

      # DOWN BUTTON
      - conditions: "{{ trigger.to_state.attributes.event_type == 'down_press' }}"
        sequence: !input down_press
      - conditions: "{{ trigger.to_state.attributes.event_type == 'down_press_release' }}"
        sequence: !input down_press_release
      - conditions: "{{ trigger.to_state.attributes.event_type == 'down_hold' }}"
        sequence: !input down_hold
      - conditions: "{{ trigger.to_state.attributes.event_type == 'down_hold_release' }}"
        sequence: !input down_hold_release

      # OFF BUTTON
      - conditions: "{{ trigger.to_state.attributes.event_type == 'off_press' }}"
        sequence: !input off_press
      - conditions: "{{ trigger.to_state.attributes.event_type == 'off_press_release' }}"
        sequence: !input off_press_release
      - conditions: "{{ trigger.to_state.attributes.event_type == 'off_hold' }}"
        sequence: !input off_hold
      - conditions: "{{ trigger.to_state.attributes.event_type == 'off_hold_release' }}"
        sequence: !input off_hold_release
