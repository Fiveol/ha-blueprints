trigger:
  - platform: event
    event_type: state_changed
    event_data:
      entity_id: !input action_sensor

condition:
  - condition: template
    value_template: '{{ trigger.event.data.new_state.state not in ("", "None", "unknown") }}'
action:
  - variables:
      helper_last_controller_event: !input helper_last_controller_event
      command: "{{ trigger.event.data.new_state.state }}"
      prev_command: "{{ states(helper_last_controller_event) }}"
  - service: input_text.set_value
    data:
      entity_id: !input helper_last_controller_event
      value: "{{ command }}"
  - choose:
      # ----------------------
      # POWER BUTTON
      # ----------------------
      - conditions: '{{ command == "power_press" }}'
        sequence: !input power_press
      - conditions: '{{ command == "power_1_click" }}'
        sequence: !input power_1_click
      - conditions: '{{ command == "power_2_click" }}'
        sequence: !input power_2_click
      - conditions: '{{ command == "power_3_click" }}'
        sequence: !input power_3_click
      - conditions: '{{ command == "power_4_click" }}'
        sequence: !input power_4_click
      - conditions: '{{ command == "power_5_click" }}'
        sequence: !input power_5_click
      - conditions: '{{ command == "power_6_click" }}'
        sequence: !input power_6_click
      - conditions: '{{ command == "power_7_click" }}'
